# ==============================================================================
# APVA Framework Enterprise Configuration (.env)
# ==============================================================================

# Core Infrastructure
APVA_ENVIRONMENT=development
APVA_LOG_LEVEL=INFO
APVA_DATABASE_URL=postgresql+asyncpg://apva:apva@localhost:5432/apva
APVA_REDIS_URL=redis://localhost:6379/0
APVA_CELERY_BROKER_URL=redis://localhost:6379/0
APVA_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & Multi-Tenancy
APVA_API_KEY=dev-local-key
APVA_JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod
APVA_RATE_LIMIT_PER_MINUTE=120
APVA_MAX_REQUEST_SIZE_BYTES=10485760
APVA_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# SSO / SAML Authentication
APVA_SSO_ALLOWED_DOMAINS=["company.com","enterprise.org","hardonia.store"]

# Evaluation & SLM Judge Defaults
APVA_DEFAULT_RAG_RELIABILITY=1.0
APVA_TARGET_APP_URL=http://localhost:8080

# Secondary OLAP Telemetry Sink (ClickHouse)
APVA_CLICKHOUSE_HOST=localhost
APVA_CLICKHOUSE_PORT=9000
APVA_CLICKHOUSE_USER=default
APVA_CLICKHOUSE_PASSWORD=
APVA_CLICKHOUSE_DATABASE=apva_analytics

# Stripe Metered Billing Integration
APVA_STRIPE_ENABLED=false
APVA_STRIPE_API_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APVA_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
